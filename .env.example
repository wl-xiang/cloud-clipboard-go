# Cloud Clipboard Go - 环境变量配置
# 复制此文件为 .env 并修改对应值

# ========== 服务器配置 ==========
# 服务器监听地址，默认为 0.0.0.0
LISTEN_IP=

# IPv6 地址，默认为空，可设置为 ::
LISTEN_IP6=

# 服务器监听端口，默认为 9501
LISTEN_PORT=9501

# 子路径，可配合 nginx 使用，格式: /cloud-clipboard
PREFIX=

# ========== 功能配置 ==========
# 历史记录的数量，默认为 100
MESSAGE_NUM=100

# 是否启用房间列表 / 房间管理功能，默认 true
# 关掉它会把「创建 / 切换 / 删除房间」的入口整块藏起来，一般不要关。
ROOM_LIST=true

# 房间管理密码：新建 / 删除 / 清理房间都要出示它（与 AUTH_PASSWORD 是两把不同的钥匙）。
# 默认 newroom123 —— 请务必改成自己的，否则等同于房间管理不设防。
ROOM_MANAGE_PASSWORD=newroom123

# ========== 认证配置 ==========
# 访问密码。默认为 root1234 —— 默认**开启**，不带密码进不了平台。
# 想改成别的就改这里；确实要开放访问就填 false。
AUTH_PASSWORD=root1234

# 房间密码 JSON，值为字符串或对象
# 格式: {"房间名":"密码","房间名":{"password":"密码","fileExpire":0},"房间名":{"fileExpire":604800}}
# fileExpire: 0=文件永不过期，>0=覆盖 FILE_EXPIRE 秒数
ROOM_AUTH_JSON={}

# ========== 限制配置 ==========
# 文本长度限制，默认为 9000
TEXT_LIMIT=9000

# 文件过期时间，默认为 3600 (1 小时)，单位为秒
FILE_EXPIRE=3600

# 文件大小限制，默认为 1073741824 (1GB)，单位为字节
FILE_LIMIT=1073741824

# ========== SSL/TLS 证书配置 ==========
# mkcert 域名或 IP，默认为空，多个用空格分隔，仅域名支持通配符 *
MKCERT_DOMAIN_OR_IP=

# 手动设置证书路径，优先级高于 MKCERT_DOMAIN_OR_IP
MANUAL_KEY_PATH=

# 手动设置证书路径，优先级高于 MKCERT_DOMAIN_OR_IP
MANUAL_CERT_PATH=
